{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Этап 0 — инвентаризация репозитория",
  "type": "object",
  "required": ["repo", "repo_path", "modules"],
  "properties": {
    "repo": {"type": "string", "minLength": 1},
    "repo_path": {"type": "string", "minLength": 1},
    "languages": {
      "description": "доля языков по числу файлов; список пар или словарь",
      "type": ["array", "object", "null"]
    },
    "frameworks": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "entry_points": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["path", "type", "source"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "type": {"enum": ["http_server", "cli", "worker", "cron", "consumer"]},
          "name": {"type": "string"},
          "target": {"type": "string"},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "external_dependencies": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name", "kind", "evidence", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["db", "queue", "http_api", "cache", "storage", "library"]},
          "evidence": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "cross_repo_signals": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["signal", "source"],
        "properties": {
          "signal": {"type": "string", "minLength": 1},
          "likely_repo": {"type": "string"},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "approx_size": {"type": ["integer", "string"]}
        }
      }
    },
    "notes_uncertain": {"type": ["array", "null"]}
  },
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^.+:[0-9]+(-[0-9]+)?$",
      "description": "ссылка вида файл:строка или файл:начало-конец"
    }
  }
}
