{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Этап 1 — карта модуля",
  "type": "object",
  "required": ["module", "purpose", "public_interface", "confidence"],
  "properties": {
    "module": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "public_interface": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["function", "class", "endpoint", "event_handler"]},
          "summary": {"type": "string"},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "depends_on": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["module", "source"],
        "properties": {
          "module": {"type": "string", "minLength": 1},
          "via": {"type": "string"},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "side_effects": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["effect", "source"],
        "properties": {
          "effect": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "notes_uncertain": {"type": ["array", "null"]}
  },
  "$defs": {
    "source": {
      "type": "string",
      "pattern": "^.+:[0-9]+(-[0-9]+)?$",
      "description": "ссылка вида файл:строка или файл:начало-конец"
    }
  }
}
