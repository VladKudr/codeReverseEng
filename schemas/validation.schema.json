{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Этап 90 — строки validation.csv (после преобразования CSV в объекты)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["req_id", "verdict", "layer1", "source", "statement"],
    "properties": {
      "req_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.\\-]+-R-[0-9]{3,}$"
      },
      "verdict": {
        "enum": ["ПОДТВЕРЖДЕНО", "ЧАСТИЧНО", "ОПРОВЕРГНУТО", "НЕ ОТНОСИТСЯ"]
      },
      "layer1": {"type": "string", "minLength": 1},
      "layer2": {"type": "string"},
      "checked_with": {
        "type": "string",
        "description": "дословно команда или вызов, которым проверялось; обязателен при вердикте не ПОДТВЕРЖДЕНО"
      },
      "source": {
        "type": "string",
        "pattern": "^.+:[0-9]+(-[0-9]+)?$"
      },
      "statement": {"type": "string", "minLength": 1}
    },
    "if": {
      "properties": {"verdict": {"not": {"const": "ПОДТВЕРЖДЕНО"}}}
    },
    "then": {
      "required": ["checked_with"],
      "properties": {"checked_with": {"minLength": 1}}
    }
  }
}
