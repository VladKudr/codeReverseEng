{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Этап 92 — предсказания кода по формулировкам правил",
  "type": "object",
  "required": ["capability", "predictions"],
  "properties": {
    "capability": {"type": "string", "minLength": 1},
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "expect"],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.\\-]+-R-[0-9]{3,}$"
          },
          "expect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "text"],
              "properties": {
                "kind": {"enum": ["check", "message", "threshold", "location", "other"]},
                "text": {"type": "string", "minLength": 1},
                "module_hint": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "notes_uncertain": {"type": ["array", "null"]}
  }
}
